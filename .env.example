# APEX-PULSE Configuration
# Safety Lock: Always default to PAPER mode.
TRADING_MODE=PAPER

# Database: SQLite with WAL mode by default; set to PostgreSQL URL in production (e.g. Render)
DATABASE_URL=sqlite:///./apex_pulse.db

# Engine & Risk Parameters
LOOP_INTERVAL_SECONDS=10
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0

# Optional Broker Credentials (Leave blank in PAPER mode)
BYBIT_MODE=paper
BYBIT_CATEGORY=linear
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
BYBIT_PRIMARY_INTERVAL=15m
BYBIT_HTF_INTERVAL=4h
BYBIT_LEVERAGE=2
CONFLUENCE_MIN_SCORE=65

# Phase 4: Cloud Forex (OANDA Practice / Deriv Demo) & Session/News Guard
FOREX_PROVIDER=paper
FOREX_SYMBOLS=EUR_USD,GBP_USD,XAU_USD
FOREX_PRIMARY_INTERVAL=15m
FOREX_HTF_INTERVAL=4h
FOREX_KILLZONE_ONLY=true
NEWS_BLACKOUT_MINUTES=30

OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_BASE_URL=https://api-fxpractice.oanda.com/v3

DERIV_API_TOKEN=
DERIV_APP_ID=1089
DERIV_ACCOUNT_ID=
DERIV_AUTH_MODE=auto

# Phase 5: +1.0R Partial Take-Profit Scale-Out
PARTIAL_TP_ENABLED=true

# Phase 6: Security (Phone PIN Gate), 2-Way Cron Engine, & Telegram Sleep Alerts
# Leave DASHBOARD_PIN blank locally to keep dashboard unlocked; set a 4-8+ digit PIN in production.
DASHBOARD_PIN=
# Stable HMAC-SHA256 signing key for session cookies (generate with: python -c "import secrets; print(secrets.token_hex(32))")
# Required on Cloud Run when DASHBOARD_PIN is set so cold starts do not force re-login.
SESSION_SECRET=
SESSION_TTL_HOURS=24

# Set true for local 24/7 loop; set false on serverless Cloud Run so Cloud Scheduler drives ticks via /api/cron/tick
ENABLE_BACKGROUND_LOOP=true
# Shared secret sent in X-Cron-Secret header for POST /api/cron/tick and POST /api/cron/daily-summary
CRON_SECRET=

# Optional Telegram Sleep Alerts (@BotFather token + numeric chat ID; leave blank to silently disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
