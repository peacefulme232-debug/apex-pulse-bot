# APEX-PULSE Configuration
# Safety Lock: Always default to PAPER mode.
TRADING_MODE=PAPER

# Database: SQLite with WAL mode by default; set to PostgreSQL URL in production (e.g. Render)
DATABASE_URL=sqlite:///./apex_pulse.db

# Engine & Risk Parameters
LOOP_INTERVAL_SECONDS=10
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0

# Optional Broker Credentials (Leave blank in PAPER mode)
BYBIT_MODE=paper
BYBIT_CATEGORY=linear
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
BYBIT_PRIMARY_INTERVAL=15m
BYBIT_HTF_INTERVAL=4h
BYBIT_LEVERAGE=2
CONFLUENCE_MIN_SCORE=65

OANDA_API_KEY=
OANDA_ACCOUNT_ID=

